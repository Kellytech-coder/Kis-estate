# ==============================================================================
# BACKEND ENVIRONMENT VARIABLES (Render / Railway / Fly.io / Heroku / Local)
# ==============================================================================

NODE_ENV=production
PORT=4000

# Allowed Frontend URL (CORS)
# In local development: http://localhost:3000
# In production: https://your-vercel-app.vercel.app
FRONTEND_URL=https://your-vercel-app.vercel.app
FRONTEND_ORIGIN=https://your-vercel-app.vercel.app

# Firebase Admin SDK Credentials
# Option A: Individual Variables
FIREBASE_PROJECT_ID=property-listing-5df59
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@property-listing-5df59.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=property-listing-5df59.firebasestorage.app

# Option B: Full JSON Service Account String (alternative to Option A)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Initial Administrator Provisioning (run: npm run create-admin)
INITIAL_ADMIN_NAME=Administrator
INITIAL_ADMIN_EMAIL=admin@yourdomain.com
INITIAL_ADMIN_PASSWORD=YourSecurePassword123!