# Server
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL (use a real, non-committed value locally and in deployment)
DATABASE_URL="postgresql://postgres:change-me@localhost:5432/property_listing?schema=public"

# Authentication: generate a long random value; never expose it to the frontend.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
SESSION_TTL_DAYS=7

# Initial administrator seed. This seed is the only admin-creation path.
INITIAL_ADMIN_NAME=Platform Administrator
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=@Kelexyrano22
