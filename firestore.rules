rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================

    // Check if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Check if the authenticated user is the owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if the current user has the ADMIN role in Firestore
    function isAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "ADMIN") ||
        (exists(/databases/$(database)/documents/user/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/user/$(request.auth.uid)).data.role == "ADMIN")
      );
    }

    // Validate safe user roles that normal clients can self-assign on registration
    function isValidClientRole(role) {
      return role == "BUYER_RENTER" || role == "SELLER_PROPERTY_OWNER";
    }

    // =========================================================================
    // USERS COLLECTION (/users/{userId})
    // =========================================================================
    match /users/{userId} {
      // Users can read their own profile; Administrators can read all user profiles
      allow read: if isOwner(userId) || isAdmin();

      // Account registration / profile creation:
      // A user may create their own document if their auth UID matches the document ID.
      // Crucial: Client CANNOT grant themselves ADMIN role.
      allow create: if isOwner(userId) &&
        isValidClientRole(request.resource.data.role) &&
        (!('isActive' in request.resource.data) || request.resource.data.isActive == true);

      // Profile updates:
      // Users can update their own document, but CANNOT escalate their role to ADMIN.
      // Admins can update any user profile.
      allow update: if (
        isOwner(userId) &&
        // Prevent changing uid
        (!('uid' in request.resource.data) || request.resource.data.uid == userId) &&
        // Prevent escalating role to ADMIN
        (!('role' in request.resource.data) ||
         request.resource.data.role == resource.data.role ||
         isValidClientRole(request.resource.data.role))
      ) || isAdmin();

      // Only administrators can delete a user record
      allow delete: if isAdmin();
    }

    // Backward-compatibility match for legacy singular 'user' collection
    match /user/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidClientRole(request.resource.data.role);
      allow update: if (
        isOwner(userId) &&
        (!('role' in request.resource.data) ||
         request.resource.data.role == resource.data.role ||
         isValidClientRole(request.resource.data.role))
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // PROPERTIES COLLECTION (/properties/{propertyId})
    // =========================================================================
    match /properties/{propertyId} {
      // Anyone (public) can read active/published listings.
      // Owners can read their own listings even if draft or archived.
      // Admins can read all listings.
      allow read: if resource.data.status in ['available', 'active', 'pending', 'sold', 'rented']
        || (isAuthenticated() && (
             resource.data.sellerId == request.auth.uid ||
             resource.data.createdById == request.auth.uid
           ))
        || isAdmin();

      // Authenticated users with seller permissions (or admins) can create listings
      allow create: if isAuthenticated() && (
        request.resource.data.sellerId == request.auth.uid ||
        request.resource.data.createdById == request.auth.uid ||
        isAdmin()
      );

      // The property creator/seller or an admin can update
      allow update: if isAuthenticated() && (
        resource.data.sellerId == request.auth.uid ||
        resource.data.createdById == request.auth.uid ||
        isAdmin()
      );

      // Only the seller who created the listing or an admin can delete
      allow delete: if isAuthenticated() && (
        resource.data.sellerId == request.auth.uid ||
        resource.data.createdById == request.auth.uid ||
        isAdmin()
      );
    }

    // =========================================================================
    // INQUIRIES COLLECTION (/inquiries/{inquiryId})
    // =========================================================================
    match /inquiries/{inquiryId} {
      // Anyone or authenticated users can submit an inquiry
      allow create: if request.resource.data.userName is string &&
                       request.resource.data.userEmail is string &&
                       request.resource.data.message is string;

      // The inquirer, property seller, or admin can read the inquiry
      allow read: if isAuthenticated() && (
        (resource.data.userId != null && resource.data.userId == request.auth.uid) ||
        (resource.data.sellerId != null && resource.data.sellerId == request.auth.uid) ||
        isAdmin()
      );

      // Property sellers can update status (confirm, complete, etc.); Admins can update
      allow update: if isAuthenticated() && (
        (resource.data.sellerId != null && resource.data.sellerId == request.auth.uid) ||
        isAdmin()
      );

      // Inquiries can only be deleted by administrators
      allow delete: if isAdmin();
    }

    // =========================================================================
    // CONTACT MESSAGES (/contactMessages/{messageId})
    // =========================================================================
    match /contactMessages/{messageId} {
      // Anyone can submit a contact message
      allow create: if request.resource.data.name is string &&
                       request.resource.data.email is string &&
                       request.resource.data.message is string;

      // Only administrators can read or manage contact submissions
      allow read, update, delete: if isAdmin();
    }

    // =========================================================================
    // LOCATIONS & AMENITIES COLLECTIONS (Metadata)
    // =========================================================================
    match /locations/{locationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /amenities/{amenityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // DEFAULT DENY
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

